<?php

use PhpMx\Trait\TerminalInstallTrait;

return new class {

    use TerminalInstallTrait;

    function __invoke()
    {
        self::blockFile('.env', 'MX-CORE', [
            'DB_MAIN_TYPE = sqlite',
        ]);

        $this->blockFile('.gitignore', 'MX-DATALAYER', [
            '/source/Model/Db*/Driver',
            '/storage/sqlite',
            '/system/datalayer/*/scheme',
        ]);
    }
};
